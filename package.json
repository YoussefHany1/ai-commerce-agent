{
  "name": "ai-commerce-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/evals/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:apply-rls": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/apply-rls.ts",
    "db:rotate-key": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/rotate-key.ts",
    "db:setup": "docker compose up -d postgres redis",
    "db:bootstrap": "npm run db:migrate && npm run db:apply-rls",
    "db:backup": "bash scripts/pg-backup.sh",
    "client:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-client.ts",
    "client:import-supabase": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-clients-to-supabase.ts",
    "operator:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-operator.ts",
    "operator:revoke-sessions": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/revoke-operator-sessions.ts",
    "check:render": "node scripts/check-render.mjs",
    "smoke:bff": "npm --prefix web run build && node scripts/smoke-bff.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node --env-file-if-exists=.env dist/server.js",
    "verify:live": "node scripts/verify-baileys-live.mjs",
    "env:local": "node scripts/make-env-local.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@sentry/node": "^10.75.0",
    "@supabase/supabase-js": "^2.117.2",
    "baileys": "6.7.24",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.5",
    "openai": "7.10.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "redis": "6.2.1",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.4.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "0.31.10",
    "js-yaml": "^5.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
