{
  "name": "ai-commerce-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "node --env-file-if-exists=.env --import tsx src/evals/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:apply-rls": "tsx --env-file-if-exists=.env scripts/apply-rls.ts",
    "db:rotate-key": "tsx --env-file-if-exists=.env scripts/rotate-key.ts",
    "db:setup": "docker compose up -d postgres redis",
    "db:bootstrap": "npm run db:migrate && npm run db:apply-rls",
    "build": "tsc",
    "start:prod": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "openai": "7.10.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "redis": "6.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
