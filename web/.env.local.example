# ---------------------------------------------------------------------------
# Merchant dashboard. `npm run dev` in this directory.
#
# The dashboard holds no credential in the browser. It authenticates with an
# HTTP-only session cookie and calls this app's own /api/* route handlers, which
# forward the cookie's session id upstream as a header the API resolves itself.
#
# Consequence worth stating plainly: the web service does NOT get ADMIN_API_KEY.
# That key belongs to machine callers (CLI, scripts) and would be an install-wide
# administrator credential sitting in a second service. Sessions are per-person and
# verifiable, so nothing here needs one. The API does not need to be CORS-reachable
# from the browser, and no privileged value may ever be prefixed NEXT_PUBLIC_ —
# anything so prefixed is inlined into the public bundle.
# ---------------------------------------------------------------------------

# Public origin of the API. Inlined at build time and used ONLY where the browser
# must navigate to it or display it: the Shopify OAuth install link and the webhook
# base URL shown on the settings page. All data goes through the same-origin proxy.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-only. Upstream the proxy forwards to. Use the internal origin in a
# container network (http://app:3000) and the public origin on a PaaS.
API_URL=http://localhost:3000

# Server-only. The operator credential the proxy attaches to every upstream call.
# Must match ADMIN_API_KEY on the API service. Never expose this to the browser.
# ADMIN_API_KEY=

# Server-only. HMAC key for the session cookie (min 32 chars). Generate: openssl rand -hex 32
# Rotating it signs every operator and client out.
# Runtime-only: the Edge middleware checks cookie shape and expiry without a secret,
# and the Node proxy verifies the HMAC. Nothing here is inlined at build time, so the
# image never carries a second copy that could drift from what the service runs with.
SESSION_SECRET=

# Server-only. Same Redis the API uses: both session epochs live there and are what
# make a revoked session stop working.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Supabase Auth. Every human credential is verified here — operator and client
# alike — so the two branches are identical apart from which account table the
# API resolves the resulting uid against.
#
# Only the public anon key is needed on this side: the web server completes the
# flows the browser cannot (PKCE callback, password-reset OTP), immediately trades
# the token for this app's own session id, and drops it. The privileged
# service-role key stays with the API service and must never appear in the web
# service at all.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co. Must match SUPABASE_URL on
# the API service.
SUPABASE_URL=

# Anon (public) publishable key. Must match SUPABASE_ANON_KEY on the API service.
# Safe to be a build-time value, but like every other key here it is server-only;
# nothing auth-related may be prefixed NEXT_PUBLIC_.
SUPABASE_ANON_KEY=

# The session cookie is Secure by default. Local dev and the compose smoke test run
# over plain http, where a browser refuses to store a Secure cookie — set this to
# false there. Leave it unset (i.e. Secure) in production.
# SESSION_COOKIE_SECURE=false
