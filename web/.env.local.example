# Base URL of the Fastify backend consumed by the dashboard.
# Defaults to http://localhost:3000 when unset.
# When set, Next.js also proxies /api/* to this origin during dev/build (same-origin).
# Bump CORS_ORIGINS=* (or include the dashboard origin) in the backend .env if you
# disable the proxy and call the API cross-origin instead.
NEXT_PUBLIC_API_URL=