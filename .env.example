PORT=3000
# development | test | production. Enables/disables body validation, verbose SQL logging, etc.
NODE_ENV=development
# debug | info | warn | error. Structured JSON logs via pino.
LOG_LEVEL=info
# Sentry DSN (optional). When set, the app reports errors + unhandled rejections to Sentry.
SENTRY_DSN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OpenRouter fallback — used only when OpenAI is not configured or a chat/embedding call
# fails (429/5xx/timeout). OPENROUTER_MODEL must support tool calling.
# OPENROUTER_EMBEDDING_MODEL must output 1536-dim vectors to match the pgvector column.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
APP_BASE_URL=http://localhost:3000
# Supabase Auth + Postgres (required once client credentials move to Supabase).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Client login/register/forgot/exchange route through Supabase Auth when these are
# set (login falls back to the legacy scrypt hash for accounts not yet imported).
# APP_BASE_URL is the base for password-recovery redirects (<base>/login/reset),
# and Supabase's SITE_URL/redirect-allowlist must include the same dashboard origin.
# Comma-separated origins allowed as OAuth post-install redirect targets (default: APP_BASE_URL origin).
OAUTH_REDIRECT_ALLOWLIST=
# Comma-separated allowed CORS origins. Default: APP_BASE_URL. Use * for permissive (dev only).
CORS_ORIGINS=
# Required in production (min 32 chars). Protect all admin API routes. Generate: openssl rand -hex 32
ADMIN_API_KEY=
# Previous ADMIN_API_KEY, accepted alongside the current one so a rotation can be
# done in two deploys. Leave empty when not rotating, then clear it on the next deploy.
ADMIN_API_KEY_PREVIOUS=
# Shared operator password for the dashboard, as a scrypt hash — NOT the plaintext.
# Required in production; the server refuses to boot without it. Generate with:
#   npm run hash-operator-password
# The dashboard exchanges the password at POST /api/auth/operator/verify, which is
# rate-limited and locked out on repeated failure.
OPERATOR_PASSWORD_HASH=
# Previous operator hash, accepted during a rotation. Clear it on the next deploy.
OPERATOR_PASSWORD_HASH_PREVIOUS=
# Signs the dashboard's session cookie. The API never reads it - the Edge middleware
# checks cookie shape only and the dashboard's Node proxy does the HMAC - so it is
# not part of the API's own environment contract. Generate: openssl rand -hex 32.
# Rotating it signs every operator out.
SESSION_SECRET=
# true | 1 when running behind a reverse proxy or PaaS edge so req.ip honors
# X-Forwarded-For; 'none' disables it explicitly. Production refuses to start
# without one of these three, because guessing wrong either rate-limits the whole
# internet as one client or lets a caller spoof its address.
TRUST_PROXY=false
# Background workers. Every replica schedules them, but each tick is gated by a Redis
# lease so only one replica runs a given worker. Set false on a web-only replica.
WORKERS_ENABLED=true
DATABASE_URL=postgres://agent_app:agent_pass@localhost:5432/ai_commerce_agent
# docker-compose: postgres superuser password (required — compose fails to start without it). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# Least-privilege runtime DB role created by scripts/apply-rls.ts. In production
# APP_DB_PASSWORD must be a strong value (apply-rls exits if it stays 'agent_pass').
APP_DB_USER=agent_app
APP_DB_PASSWORD=agent_pass
# Redis password — compose requires it and starts redis with --requirepass. In production generate: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
SHOPIFY_API_VERSION=2026-07
# fts | vector | hybrid (vector/hybrid need OPENAI_API_KEY to embed; hybrid degrades to fts)
RETRIEVAL_MODE=hybrid
# off | synonym | embedding (embedding falls back to synonym without OPENAI_API_KEY)
RETRIEVAL_RE_RANK=synonym
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# Optional comma-separated scope overrides for the Salla/Zid install flows.
# Salla default is offline_access (required for refresh tokens); product/order
# scopes must match the app's registered capabilities on the Salla Partner Portal.
# Zid embedded apps need the "embedded_apps_tokens_write" scope in ZID_SCOPES.
SALLA_SCOPES=offline_access
ZID_SCOPES=
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1
# Add ENCRYPTION_KEY_v2=... when rotating; active version is ENCRYPTION_KEY_VERSION.
# Admin DSN only used by scripts (key rotation). Defaults to the postgres superuser.
PGADMIN_URL=
# WhatsApp Cloud API (Meta). Verify token shared between app and Meta during webhook subscribe.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Stripe billing. STRIPE_SECRET_KEY is the restricted/limited key for Checkout + Billing Portal;
# STRIPE_WEBHOOK_SECRET is the webhook signing secret for /webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Per-tenant Redis rate limits (fixed window, keyed by store_id). Lower chat limit protects LLM spend.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_CHAT_PER_MIN=20
# Customer session TTL (seconds). Tokens minted via POST /api/session bound a customer to a conversation.
SESSION_TTL_SECONDS=3600
# Merchant client session TTL (seconds). Dashboard client (store) sessions; changed on first login,
# revoked on suspension/password reset via the per-account epoch. Mirrored by the BFF cookie.
CLIENT_SESSION_TTL_SECONDS=28800
# Max accepted webhook body size in bytes (protects against memory exhaustion from oversized payloads).
WEBHOOK_BODY_LIMIT=5242880
# PDPL retention windows (days). Retention worker purges stores every 6h; set RETENTION_ENABLED=false to disable.
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_ATTRIBUTIONS_DAYS=365
RETENTION_EVENTS_DAYS=90
RETENTION_CUSTOMER_ORPHAN_DAYS=730
RETENTION_ENABLED=true
# --- Tests (used only by npm run test -- src/tests/integration.spec.ts; suites skip when unset) ---
# Point these at a disposable Postgres/Redis instance (see .github/workflows/ci.yml)
# plus an SSH-tunneled staging DB for the migrations job, e.g.:
# COMPOSE_SSH_TUNNEL_HOSTS=db1:5432,db2:5432
# COMPOSE_SSH_TUNNEL_JUMP_HOST=bastion.example.com
TEST_APP_DB_URL=
TEST_PGADMIN_URL=
TEST_REDIS_URL=